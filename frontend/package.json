{
  "name": "arkray-crm-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:types": "openapi-typescript ../backend/openapi.yaml --immutable -o src/lib/api/schema.gen.ts",
    "api:check": "openapi-typescript ../backend/openapi.yaml --immutable -o src/lib/api/schema.gen.ts --check"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12"
  }
}
