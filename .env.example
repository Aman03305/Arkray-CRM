# Arkray CRM — local development configuration.
# Copy to `.env` (never commit `.env`). Every value here is a DEV-ONLY placeholder.
# Production secrets come from the deployment's secret manager, never from files in git.

# --- Docker Compose (local infrastructure) -------------------------------------------
# Host ports are deliberately non-default so Arkray never collides with other local stacks.
POSTGRES_DB=arkray
POSTGRES_USER=arkray
POSTGRES_PASSWORD=arkray_dev_only_password
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
MAILPIT_SMTP_HOST_PORT=51025
MAILPIT_UI_HOST_PORT=58025
API_HOST_PORT=8000
WEB_HOST_PORT=3000

# --- Django ----------------------------------------------------------------------------
# Generate a real key with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me-0000000000000000000000000000000000
# During a key rotation only: the previous key(s), comma-separated (docs/runbooks.md#rotate-a-secret).
# DJANGO_SECRET_KEY_FALLBACKS=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# The browser talks to Next.js (:3000), which proxies /api to Django, so Django must trust that origin.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
# json (default, machine-readable) or console (human-readable while developing)
LOG_FORMAT=console

DATABASE_URL=postgres://arkray:arkray_dev_only_password@127.0.0.1:55432/arkray
DB_STATEMENT_TIMEOUT_MS=10000
DB_POOL_ENABLED=false

CELERY_BROKER_URL=redis://127.0.0.1:56379/0
REDIS_CACHE_URL=redis://127.0.0.1:56379/1

EMAIL_URL=smtp://127.0.0.1:51025
DEFAULT_FROM_EMAIL=Arkray CRM <no-reply@arkray.local>
# Public URL of the web app: invitation and password-reset emails link here.
APP_BASE_URL=http://localhost:3000

# --- Ask Arkray (docs/rag-architecture.md) ----------------------------------------------
# The CRM is fully functional without it. Embeddings are computed locally (no key needed:
# `manage.py ai_fetch_model` downloads the pinned model for local development).
AI_ENABLED=true
# "none": no language model (structured questions + best-matching records, no CRM text
# leaves the deployment). "anthropic": Claude, needs ANTHROPIC_API_KEY.
AI_LLM_PROVIDER=none
# The key goes to the process that calls the provider only (AI_LLM_KEY_HOLDER=true, the ai
# worker); every other process runs with AI_LLM_KEY_HOLDER=false and refuses a key.
# ANTHROPIC_API_KEY=
# AI_LLM_KEY_HOLDER=true
# AI_CHAT_MODEL=claude-opus-5-5

# --- Frontend --------------------------------------------------------------------------
# Where the Next.js server proxies /api/* during development.
API_ORIGIN=http://localhost:8000

# Metrics endpoint (/health/metrics): a scraper sends "Authorization: Bearer <token>".
# Empty: the endpoint does not exist. At least 32 characters when set (production refuses
# a shorter one), for example: python -c "import secrets; print(secrets.token_urlsafe(32))"
METRICS_TOKEN=

# --- Production only (docs/deployment.md) ------------------------------------------------
# Never set these in this file for a real deployment: they come from the secret manager.
# Listed so nothing is forgotten; the production rehearsal stack
# (infrastructure/compose.production.yml) refuses to start without the first four.
# POSTGRES_PASSWORD=          # the database superuser's (provisioning only)
# ARKRAY_OWNER_PASSWORD=      # arkray_owner: migrations
# ARKRAY_APP_PASSWORD=        # arkray_app: the web servers and workers
# REDIS_PASSWORD=             # production refuses Redis URLs without one
# TRUSTED_PROXY_COUNT=1       # required in production: proxies in front of Django
# ATTACHMENT_STORAGE=s3
# ATTACHMENT_S3_BUCKET=
# Prefer an IAM role; static keys only where the platform has none.
# ATTACHMENT_S3_ACCESS_KEY_ID=
# ATTACHMENT_S3_SECRET_ACCESS_KEY=
# NEVER in a real deployment: the local stack's plain-HTTP opt-in (localhost names only).
# DJANGO_ALLOW_INSECURE_LOCAL_HTTP=
