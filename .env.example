# Arkray CRM — local development configuration.
# Copy to `.env` (never commit `.env`). Every value here is a DEV-ONLY placeholder.
# Production secrets come from the deployment's secret manager, never from files in git.

# --- Docker Compose (local infrastructure) -------------------------------------------
# Host ports are deliberately non-default so Arkray never collides with other local stacks.
POSTGRES_DB=arkray
POSTGRES_USER=arkray
POSTGRES_PASSWORD=arkray_dev_only_password
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
MAILPIT_SMTP_HOST_PORT=51025
MAILPIT_UI_HOST_PORT=58025
API_HOST_PORT=8000
WEB_HOST_PORT=3000

# --- Django ----------------------------------------------------------------------------
# Generate a real key with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me-0000000000000000000000000000000000
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# The browser talks to Next.js (:3000), which proxies /api to Django, so Django must trust that origin.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
# json (default, machine-readable) or console (human-readable while developing)
LOG_FORMAT=console

DATABASE_URL=postgres://arkray:arkray_dev_only_password@127.0.0.1:55432/arkray
DB_STATEMENT_TIMEOUT_MS=10000
DB_POOL_ENABLED=false

CELERY_BROKER_URL=redis://127.0.0.1:56379/0
REDIS_CACHE_URL=redis://127.0.0.1:56379/1

EMAIL_URL=smtp://127.0.0.1:51025
DEFAULT_FROM_EMAIL=Arkray CRM <no-reply@arkray.local>
# Public URL of the web app: invitation and password-reset emails link here.
APP_BASE_URL=http://localhost:3000

# --- CRM business settings -------------------------------------------------------------
# Day boundaries for "today" metrics (new leads today, tasks due today, ...) use this zone.
CRM_TIME_ZONE=Asia/Kolkata
CRM_CURRENCY=INR

# --- Ask Arkray (Phase 8) --------------------------------------------------------------
# Leave AI disabled until Phase 8. The CRM is fully functional without it.
AI_ENABLED=false
# ANTHROPIC_API_KEY=
# EMBEDDINGS_API_KEY=

# --- Frontend --------------------------------------------------------------------------
# Where the Next.js server proxies /api/* during development.
API_ORIGIN=http://localhost:8000
