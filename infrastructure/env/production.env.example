# Arkray CRM: the production (and staging) environment, every variable the deployment sets.
#
# A template, never a configuration: copy the values into the platform's secret manager and
# manifests (docs/deployment.md#configuration, docs/security.md#secrets-management), never
# into a repository or an image. Placeholders:
#   change-me-...       a secret, or a name only the deployment knows (a bucket, the edge's
#                       address): from the secret manager. Unfilled, production refuses to
#                       start (the keys are too short, the address isn't one);
#   *.example.com       the deployment's own host names;
#   /etc/arkray/...     files mounted read-only into the container (CA certificates, keys).
# Every other value is the safe one, written out. Production refuses anything weaker
# (config/settings/production.py); tests/architecture/test_env_templates.py fills this file
# in and proves both: it starts as it is, and refuses each security setting weakened.
#
# Format: KEY=value, one per line, no quotes, no comment after a value (docker --env-file,
# Compose env_file and Kubernetes keep both literally). Three kinds of line:
#   KEY=value            every process of the backend image: api, worker-outbox,
#                        worker-default, worker-index, worker-ai, beat, migrate and one-off
#                        management commands (they must agree: one erasure ledger, one key);
#   # KEY=value          optional, shown with the value it has when left out;
#   #[name] KEY=value    the service or variant `name` only, on top of the shared lines
#                        (drop the `#[name] ` prefix in its environment). Backend services:
#                        api, migrate, worker-outbox, worker-default, worker-index,
#                        worker-ai; variant: single-host. Elsewhere: web, web-build,
#                        provisioning, backup, restore, clamav.
# Which process holds which secret is the point of the split: the provider key only in
# worker-ai, the schema owner's password only in migrate and restore, the backup keys only
# on the backup host. The web tier and the edge hold none.
#
# Never, in any environment that serves real users: DJANGO_ALLOW_INSECURE_LOCAL_HTTP (the
# local stack's plain-HTTP opt-in; refused for a public host name), LOG_EXCEPTION_MESSAGES,
# ANTHROPIC_LOG, ANTHROPIC_BASE_URL and ANTHROPIC_CUSTOM_HEADERS (production refuses them),
# BACKUP_ALLOW_UNENCRYPTED and RESTORE_UNVERIFIED (throwaway drills only). Not here on
# purpose: ATTACHMENT_SCANNER_WAIVED, the organisation's written acceptance of unscanned
# attachments (R94), set only together with removing ATTACHMENT_SCANNER, never by default.
#
# Staging: this same file and production's settings module, with its own values. It differs
# only in what it points at, never in how safe it is (production's checks run there too):
#   - its own secret for every change-me value, never production's: a staging leak must not
#     open production;
#   - its own host names (DJANGO_ALLOWED_HOSTS, DJANGO_CSRF_TRUSTED_ORIGINS, APP_BASE_URL),
#     database, Redis instances, buckets and erasure ledger (a separate bucket or volume:
#     two environments must never share a ledger);
#   - a sender on a staging domain or subdomain with its own SPF, DKIM and DMARC, or a
#     capture relay that still takes STARTTLS with a verified certificate;
#   - AI_LLM_PROVIDER=none unless the data-processing agreement covers staging, and real
#     personal data only under production's controls;
#   - smaller sizing (WEB_CONCURRENCY, replicas); the same ClamAV setup, to rehearse it;
#   - a restore of production's backup into staging is a restore like any other: replay the
#     erasures against production's ledger first (docs/runbooks.md#restore-from-backup).
# Check a filled environment from inside the backend image before traffic:
#   python manage.py preflight [--base-url https://crm.example.com]
#
# Every password and key here is generated for its environment (config/credentials.py: 32+
# characters, evenly random, no repeated part, keyboard run or words, never a value the
# repository publishes, never one used for two secrets; `openssl rand -hex 32`). Production refuses a database or Redis password the
# repository publishes; preflight's `credentials` checks fail a weak one. The single-host
# reference stack (infrastructure/compose.production.yml) takes its secrets from a file of
# its own under production-only names (ARKRAY_PROD_*, scripts/init-prod-env.sh), never
# from the repository's .env (adversarial review of 73ff1e3, M4).


# ---- Core and HTTP (docs/deployment.md#configuration) -------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.production
# The image's own (its Dockerfile); a host installation sets it in every service unit: with
# it a process without DJANGO_SETTINGS_MODULE uses production's, never the development one.
ARKRAY_RUNTIME=production
# 50+ characters, 5+ distinct: python -c "import secrets; print(secrets.token_urlsafe(64))".
# Rotation (docs/runbooks.md#rotate-a-secret): the previous key in the fallbacks for a day,
# `manage.py mfa_reencrypt`, then remove it.
DJANGO_SECRET_KEY=change-me-django-secret-key
# DJANGO_SECRET_KEY_FALLBACKS=
# The public name, and the Host the probes send if it isn't that one (a service name such
# as `api`); never `*`.
DJANGO_ALLOWED_HOSTS=crm.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://crm.example.com
APP_BASE_URL=https://crm.example.com
DJANGO_SECURE_COOKIES=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=31536000
# true (and preload at the edge) only once every subdomain is HTTPS.
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
# Two-step verification for administrators (ADR-0033); false is refused.
MFA_REQUIRED_FOR_ADMINS=true
# Two-step verification for every user (review of 73ff1e3, L1): true by default; an
# organisational policy, so false is accepted (docs/deployment.md, owner decision).
MFA_REQUIRED_FOR_ALL_USERS=true
# One edge proxy appends X-Forwarded-For; it is believed only from the edge's own
# addresses as Django sees them connect (docs/deployment.md#reverse-proxy).
TRUSTED_PROXY_COUNT=1
TRUSTED_PROXY_ADDRESSES=change-me-edge-proxy-address
# The edge mints X-Request-ID (the reference nginx does).
TRUST_INCOMING_REQUEST_ID=true
# SESSION_COOKIE_AGE_S=43200
# SESSION_IDLE_TIMEOUT_S=7200
# ACCOUNT_INVITATION_TTL_S=259200
# PASSWORD_RESET_TTL_S=3600
# TEMPORARY_PASSWORD_TTL_S=259200
# WORKSPACE_ACCESS_AUDIT_WINDOW_S=900
# SUPPORT_SESSION_TTL_S=1800

# gunicorn (api only; docs/deployment.md#configuration): the same address as
# TRUSTED_PROXY_ADDRESSES, never `*`.
#[api] FORWARDED_ALLOW_IPS=change-me-edge-proxy-address
#[api] PORT=8000
#[api] WEB_CONCURRENCY=4
#[api] GUNICORN_TIMEOUT_S=30


# ---- Database (docs/deployment.md#database, docs/security.md#backend-tls) ----------------
# The application role, over verified TLS: sslmode=verify-full and the provider's CA
# (sslrootcert=system for a publicly trusted certificate). Percent-encode a password's
# reserved characters (@ : / ? # % &). PgBouncer's address when it's in place, and then
# DB_TRANSACTION_POOLER true with the timeouts on the role (docs/deployment.md#database-poolers).
DATABASE_URL=postgres://arkray_app:change-me-app-password@db.example.com:5432/arkray?sslmode=verify-full&sslrootcert=/etc/arkray/tls/db-ca.crt
# The web server and workers refuse a superuser or a role that owns the audit trail (R74).
DB_REQUIRE_RESTRICTED_ROLE=true
# Single-label service names reached without TLS on the private network: ClamAV only
# (clamd has no TLS). Never a dotted name or an address.
BACKEND_TLS_PRIVATE_HOSTS=clamav
# DB_TRANSACTION_POOLER=false
# DB_CONNECT_TIMEOUT_S=5
# DB_STATEMENT_TIMEOUT_MS=10000
# DB_LOCK_TIMEOUT_MS=5000
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# DB_CONN_MAX_AGE_S=60
# A per-process pool for threaded servers (docs/reliability.md#connection-budget).
# DB_POOL_ENABLED=false
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=4
# DB_POOL_TIMEOUT_S=5

# migrate: the release job and the restore-time commands (replay_erasures,
# audit_minimise_legacy), as the schema owner, on a direct connection (never a transaction
# pooler). Nothing long-running holds this password.
#[migrate] DATABASE_URL=postgres://arkray_owner:change-me-owner-password@db.example.com:5432/arkray?sslmode=verify-full&sslrootcert=/etc/arkray/tls/db-ca.crt

# Workers: background work may run longer than a request (docs/deployment.md#database).
#[worker-outbox] DB_STATEMENT_TIMEOUT_MS=60000
#[worker-default] DB_STATEMENT_TIMEOUT_MS=60000
#[worker-index] DB_STATEMENT_TIMEOUT_MS=60000
#[worker-ai] DB_STATEMENT_TIMEOUT_MS=60000


# ---- Redis, background work (docs/deployment.md#production-topology) ---------------------
# Two instances, both with a password and verified TLS (leave out ssl_ca_certs for a
# publicly trusted certificate; an ACL user is rediss://user:password@...). The broker
# never evicts (noeviction, AOF); the cache evicts (allkeys-lru) and persists nothing.
CELERY_BROKER_URL=rediss://:change-me-broker-password@broker.example.com:6380/0?ssl_cert_reqs=required&ssl_ca_certs=/etc/arkray/tls/redis-ca.crt
REDIS_CACHE_URL=rediss://:change-me-cache-password@cache.example.com:6380/0?ssl_cert_reqs=required&ssl_ca_certs=/etc/arkray/tls/redis-ca.crt
# OUTBOX_DONE_RETENTION_DAYS=7
# Write budgets (0 turns either off): activities one person creates a day; per customer.
# ACTIVITY_MAX_CREATED_PER_USER_PER_DAY=1000
# ACTIVITY_MAX_PER_CUSTOMER=5000


# ---- Email (docs/deployment.md#email) ----------------------------------------------------
# Authenticated submission with STARTTLS (smtp+tls://, port 587) or implicit TLS
# (smtp+ssl://, port 465); certificate and host name always verified. A user name that is an
# email address is percent-encoded (user%40example.com).
EMAIL_URL=smtp+tls://change-me-smtp-user:change-me-smtp-password@smtp.example.com:587
# A private CA for the relay's certificate (PEM); empty: the system store.
# EMAIL_TLS_CA_FILE=
# EMAIL_TIMEOUT_S=10
# A real domain with SPF, DKIM and DMARC. A display name ("Arkray CRM <...>") needs quotes
# wherever a shell reads this file.
DEFAULT_FROM_EMAIL=no-reply@crm.example.com


# ---- Attachments and exports (docs/deployment.md#attachments, #attachments-storage) -------
# A private bucket: block public access, versioning, default encryption, replication.
ATTACHMENT_STORAGE=s3
ATTACHMENT_S3_BUCKET=change-me-attachments-bucket
# An S3-compatible store's https:// endpoint and region; empty: AWS's own (https).
# ATTACHMENT_S3_ENDPOINT_URL=
# ATTACHMENT_S3_REGION=
# A private CA bundle for a self-hosted store; certificates are always verified.
# ATTACHMENT_S3_CA_BUNDLE=
# Prefer a workload identity (an IAM role): nothing to rotate. Static keys, if any, may only
# read, write, delete and list versions under the two prefixes below.
# ATTACHMENT_S3_ACCESS_KEY_ID=
# ATTACHMENT_S3_SECRET_ACCESS_KEY=
# ATTACHMENT_S3_PREFIX=attachments
# EXPORT_S3_PREFIX=exports
# A versioned bucket: purging a deleted file removes its earlier versions too (needs
# s3:ListBucketVersions and s3:DeleteObjectVersion; docs/privacy.md#attachments).
ATTACHMENT_S3_PURGE_VERSIONS=true
# Malware scanning (R94): the ClamAV daemon only the scanning worker (worker-default) can
# reach. Every process names it (production refuses to start without it); only that worker
# connects.
ATTACHMENT_SCANNER=clamd://clamav:3310
# ATTACHMENT_S3_CONNECT_TIMEOUT_S=3
# ATTACHMENT_S3_READ_TIMEOUT_S=10
# ATTACHMENT_S3_MAX_ATTEMPTS=2
# ATTACHMENT_STORAGE_DEADLINE_S=12.0
# ATTACHMENT_STORAGE_MAX_IN_FLIGHT=4
# ATTACHMENT_STORAGE_MAX_IN_FLIGHT_SHARED=3
# ATTACHMENT_STORAGE_BREAKER_FAILURES=3
# ATTACHMENT_STORAGE_BREAKER_COOLDOWN_S=15.0
# ATTACHMENT_RECONCILE_DAILY=true
# ATTACHMENT_MAX_BYTES=10485760
# ATTACHMENT_MAX_PER_NOTE=10
# ATTACHMENT_MAX_BYTES_PER_USER=2147483648
# ATTACHMENT_ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,webp,docx,xlsx,csv,txt
# EXPORT_TTL_HOURS=24
# EXPORT_MAX_BYTES=104857600
# EXPORT_MAX_PENDING_PER_ADMIN=3
# EXPORT_MAX_PER_HOUR=20


# ---- Erasure ledger and retention (docs/privacy.md#restore-safe-erasure) ------------------
# A bucket of its own (versioning, Object Lock in compliance mode, replication), never in a
# database backup, the same URL and key in every backend process. Its client takes AWS's
# default credentials (the workload identity, or AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY): it has no key settings of its own.
ERASURE_LEDGER_URL=s3://change-me-erasure-ledger-bucket/production
# 32+ characters, not the Django key; rotation: docs/runbooks.md#rotate-the-erasure-ledger-key.
ERASURE_LEDGER_KEY=change-me-erasure-ledger-key
# ERASURE_LEDGER_VERIFY_KEYS=
# ERASURE_LEDGER_S3_ENDPOINT_URL=
# ERASURE_LEDGER_S3_REGION=
# ERASURE_LEDGER_S3_CA_BUNDLE=
# ERASURE_LEDGER_CHECK_INTERVAL_S=60
# ERASURE_LEDGER_MAX_STALE_S=3600
# ERASURE_LEDGER_AUTO_RECONCILE_MAX=10
# The organisation's retention policy (docs/privacy.md#retention).
# AUDIT_DETAIL_RETENTION_DAYS=90

# A single host instead of buckets: private volumes mounted at these paths in every backend
# container (the ledger's in none other; docs/deployment.md#production-topology).
#[single-host] ATTACHMENT_STORAGE=filesystem
#[single-host] ATTACHMENT_ROOT=/var/lib/arkray/attachments
#[single-host] EXPORT_ROOT=/var/lib/arkray/exports
#[single-host] ERASURE_LEDGER_URL=file:///var/lib/arkray/ledger


# ---- Rate limits (docs/deployment.md#configuration) --------------------------------------
# Size API_THROTTLE_AUTH to the largest office behind one address (R77).
# API_THROTTLE_USER=600/min
# API_THROTTLE_ANON=60/min
# API_THROTTLE_AUTH=20/min
# API_THROTTLE_SEARCH=120/min
# API_THROTTLE_ASK=20/min
# API_THROTTLE_ATTACHMENTS=30/min


# ---- Observability (docs/observability.md) -----------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
# /health/metrics for a scraper sending it as a bearer token: 32+ characters.
METRICS_TOKEN=change-me-metrics-token


# ---- Ask Arkray (docs/deployment.md#ai-configuration) ------------------------------------
# Off until decided. none: no CRM text leaves the deployment. anthropic: needs a
# data-processing agreement first (R68), and the key in worker-ai alone.
AI_ENABLED=false
# AI_INDEXING_ENABLED=false
AI_LLM_PROVIDER=none
# No process but worker-ai holds the key (and the default is true).
AI_LLM_KEY_HOLDER=false
AI_LLM_BASE_URL=https://api.anthropic.com
AI_EMBEDDING_PROVIDER=local
# AI_EMBEDDING_MODEL_DIR=/opt/models/bge-small-en-v1.5
# AI_EMBEDDING_THREADS=2
# AI_CHAT_MODEL=claude-opus-5-5
# AI_CHAT_EFFORT=low
# AI_CHAT_MAX_TOKENS=8000
# AI_LLM_TIMEOUT_S=20.0
# AI_LLM_MAX_RETRIES=1
# AI_QUESTION_BUDGET_S=30.0
# AI_MAX_TOOL_ROUNDS=4
# AI_MAX_TOOL_CALLS_PER_ROUND=6
# AI_BREAKER_FAILURES=3
# AI_BREAKER_COOLDOWN_S=60
# AI_RETRIEVAL_TOP_K=8
# AI_RETRIEVAL_MIN_SIMILARITY=0.55
# AI_CONTEXT_MAX_CHARS=12000
# AI_TOOL_RESULTS_MAX_CHARS=40000
# AI_HISTORY_TURNS=4
# AI_QUESTION_TIMEOUT_S=90
# AI_MAX_PENDING_PER_USER=2
# AI_MAX_PENDING_TOTAL=40
# AI_MAX_QUESTIONS_PER_USER_PER_DAY=200
# AI_CONVERSATION_RETENTION_DAYS=30

# worker-ai: the only process that calls the provider. Its key only when every process has
# the anthropic provider; otherwise leave it out.
#[worker-ai] AI_LLM_KEY_HOLDER=true
#[worker-ai] ANTHROPIC_API_KEY=change-me-anthropic-api-key


# ---- Web tier (frontend image; docs/deployment.md#configuration) -------------------------
# No secrets: it renders pages; the browser fetches every record from /api through the
# edge. The image's own defaults:
#[web] NODE_ENV=production
#[web] PORT=3000
#[web] HOSTNAME=0.0.0.0
# A build argument, not runtime: where Next.js proxies /api when the edge doesn't route it
# (the local stack). Behind the reference edge it is never used.
#[web-build] API_ORIGIN=http://api:8000


# ---- Edge proxy (infrastructure/nginx/arkray.conf; docs/deployment.md#reverse-proxy) -----
# No environment: set server_name to the public name, the certificate and key paths, and the
# 80/443 listeners in the file. Its address on the network it shares with the API is
# TRUSTED_PROXY_ADDRESSES and FORWARDED_ALLOW_IPS above. It holds only its TLS key.


# ---- Provisioning (infrastructure/postgres/roles.sql, once per environment) --------------
# A database administrator's session; the two roles' passwords come from here and go to the
# secret manager (the app role's into DATABASE_URL, the owner's into migrate's).
#[provisioning] ADMIN_DATABASE_URL=postgres://change-me-db-admin-user:change-me-db-admin-password@db.example.com:5432/postgres?sslmode=verify-full&sslrootcert=/etc/arkray/tls/db-ca.crt
#[provisioning] OWNER_PASSWORD=change-me-owner-password
#[provisioning] APP_PASSWORD=change-me-app-password


# ---- Backups (scripts/backup.sh; docs/deployment.md#backup-restore-and-disaster-recovery) -
# The backup host: a role that can read every table (the owner, or a read-only role:
# GRANT pg_read_all_data), verified TLS, the backup PUBLIC key and its own signing key
# (docs/runbooks.md#backup-encryption-keys). Never BACKUP_ALLOW_UNENCRYPTED.
#[backup] DATABASE_URL=postgres://change-me-backup-user:change-me-backup-password@db.example.com:5432/arkray?sslmode=verify-full&sslrootcert=/etc/arkray/tls/db-ca.crt
#[backup] BACKUP_GPG_RECIPIENT_FILE=/etc/arkray/backup/backup-public-key.asc
#[backup] BACKUP_GPG_SIGNING_KEY_FILE=/etc/arkray/backup/backup-signing-key.asc
#[backup] BACKUP_GPG_SIGNING_PASSPHRASE_FILE=/etc/arkray/backup/backup-signing-passphrase
#[backup] BACKUP_RETENTION_DAYS=30
#[backup] BACKUP_KEEP_MINIMUM=7

# Where a restore happens (scripts/restore.sh; docs/runbooks.md#restore-from-backup): an
# EMPTY database prepared by roles.sql, as the owner; the backup PRIVATE key brought in for
# the restore only; the signer's PUBLIC key. Never RESTORE_UNVERIFIED.
#[restore] TARGET_DATABASE_URL=postgres://arkray_owner:change-me-owner-password@db.example.com:5432/arkray_restored?sslmode=verify-full&sslrootcert=/etc/arkray/tls/db-ca.crt
#[restore] BACKUP_GNUPGHOME=/etc/arkray/restore/keyring
#[restore] BACKUP_SIGNER_KEY_FILE=/etc/arkray/backup/backup-signing-public-key.asc
#[restore] RESTORE_WORK_DIR=/var/lib/arkray/restore-work
#[restore] RESTORE_JOBS=4
#[restore] RESTORE_MAINTENANCE_WORK_MEM=1GB


# ---- ClamAV (infrastructure/clamav/; docs/operations.md#clamav-signature-freshness) -------
#[clamav] FRESHCLAM_CHECKS=12
#[clamav] CLAMAV_MAX_SIGNATURE_AGE_S=259200
